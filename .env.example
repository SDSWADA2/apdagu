# ==============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES
# Salin file ini menjadi .env sebelum dijalankan
# ==============================================================================

# 1. Server
NODE_ENV=production
PORT=3001

# 2. Autentikasi JWT
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter_xxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=8h

# ==============================================================================
# 3. SUPABASE (Database Utama)
# Dapatkan dari: https://supabase.com/dashboard/project/<PROJECT_ID>/settings/database
# ==============================================================================

# Koneksi PostgreSQL via Supabase Pooler (Transaction Mode — recommended)
# Ganti [PASSWORD] dengan Database Password dari Supabase Dashboard
DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[SDNSw-02]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. CORS (Frontend domain, pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3001,https://domain-anda.com

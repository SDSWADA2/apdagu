# ==============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES
# ==============================================================================
# Rename file ini menjadi .env sebelum dijalankan secara lokal (jika perlu)
# Pada platform Cloud Hosting (Render, Railway, Vercel), set konfigurasi 
# ini di bagian "Environment Variables" / "Secrets" di dashboard mereka.

# 1. Konfigurasi Server
NODE_ENV=production
PORT=3000

# 2. Keamanan & Autentikasi
# Ganti dengan secret acak yang kuat (min 32 karakter)
JWT_SECRET=rahasia_jwt_produksi_yang_sangat_panjang_sekali_12345
JWT_EXPIRES_IN=1d

# 3. Konfigurasi Database PostgreSQL
# Jika menggunakan layanan database cloud seperti Neon, Supabase, Railway, dll.
# Format: postgres://[user]:[password]@[host]:[port]/[db_name]?sslmode=require
DATABASE_URL=postgres://user:password@hostname:5432/dbname?sslmode=require

# Alternatif Konfigurasi Database (Jika tidak menggunakan DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=rahasia
# DB_NAME=db_guru_sd

# 4. CORS (Opsional)
# Jika front-end dan back-end berada di domain yang berbeda
# ALLOWED_ORIGINS=https://domain-frontend.com,https://domain-alternatif.com

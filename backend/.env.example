# ============================================================================
# KONFIGURASI ENVIRONMENT BACKEND — SD NEGERI SUMBER WARU 2
# ============================================================================
# PENTING: Salin file ini menjadi ".env" di folder backend/
# JANGAN pernah commit file .env ke Git (sudah ada di .gitignore)
# ============================================================================

# 1. KONFIGURASI SERVER
PORT=3000
NODE_ENV=development

# 2. KONFIGURASI DATABASE MYSQL / MARIADB
# Untuk XAMPP lokal → DB_USER=root, DB_PASSWORD= (kosong)
# Untuk WAMP lokal  → DB_USER=root, DB_PASSWORD= (kosong)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_guru_sd
DB_CONNECTION_LIMIT=10
DB_SSL=false

# 3. KEAMANAN JWT (JSON Web Token)
# WAJIB diganti ke string acak panjang di production!
# Contoh: openssl rand -base64 48
JWT_SECRET=super_secret_key_sdn_sumber_waru_2_2026
JWT_EXPIRES_IN=8h

# 4. CORS (Daftar origin yang diizinkan, pisahkan dengan koma)
# Development: boleh kosong (semua localhost diizinkan)
# Production: isi dengan URL frontend Anda yang sebenarnya
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# 5. OPSIONAL — Lewati autentikasi JWT saat testing lokal (HANYA development!)
# SKIP_AUTH=true

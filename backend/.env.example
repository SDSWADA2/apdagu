# Contoh file .env untuk backend — JANGAN masukkan nilai sensitif ke repo
# Salin file ini menjadi backend/.env dan isi nilai sebenarnya pada server/deploy.

# Server
PORT=3000
NODE_ENV=development

# Database (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=aplikasi_guru_sd

# JWT
JWT_SECRET=change_me_to_a_strong_secret

# CORS: daftar origin yang diizinkan, pisahkan dengan koma
# Contoh: http://localhost:5500,http://localhost:3000,https://app.example.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

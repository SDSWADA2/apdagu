{
  "name": "sdn-sumber-waru-2-backend",
  "version": "2.0.0",
  "description": "REST API Backend — Aplikasi Database Guru SD Negeri Sumber Waru 2 (Production Realtime)",
  "main": "server.js",
  "scripts": {
    "start"           : "node server.js",
    "dev"             : "nodemon server.js",
    "db:setup"        : "node scripts/setup_db.js",
    "db:autofix"      : "node scripts/auto_fix.js",
    "db:migrate"      : "node scripts/migration_realtime.js",
    "audit"           : "npm audit --audit-level=moderate",
    "audit:fix"       : "npm audit fix"
  },
  "dependencies": {
    "bcrypt"              : "^5.1.1",
    "compression"         : "^1.7.4",
    "cors"                : "^2.8.5",
    "dotenv"              : "^16.4.5",
    "express"             : "^4.19.2",
    "express-rate-limit"  : "^7.3.1",
    "helmet"              : "^7.1.0",
    "jsonwebtoken"        : "^9.0.2",
    "morgan"              : "^1.11.0",
    "pg"                  : "^8.11.3",
    "socket.io"           : "^4.7.5",
    "swagger-ui-express"  : "^5.0.1",
    "yamljs"              : "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "bcrypt@5.1.1"      : true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

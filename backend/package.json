{
  "name": "sdn-sumber-waru-2-backend",
  "version": "1.1.0",
  "description": "REST API Backend for Aplikasi Database Guru SD Negeri Sumber Waru 2",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check middleware/auth.js && node --check routes/auth.js",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "docs": "NODE_ENV=development node server.js",
    "migrate": "npx knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "npx knex migrate:rollback --knexfile knexfile.js",
    "seed": "npx knex seed:run --knexfile knexfile.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^2.4.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.7",
    "swagger-ui-express": "^4.6.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
